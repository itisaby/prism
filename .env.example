# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Composer / investigator model
PRISM_MODEL=claude-opus-5-5
# 32+ random chars; encrypts connection tokens at rest (openssl rand -hex 32)
PRISM_SECRET=
# Allow http://localhost MCP URLs (needed for the port-forwarded k8s server in the demo)
PRISM_ALLOW_LOCAL_MCP=1
# Bearer token for the in-cluster k8s MCP server (written by infra/k8s/setup.sh)
K8S_MCP_TOKEN=
# Optional: route MCP calls through agentgateway (e.g. http://localhost:7200)
PRISM_GATEWAY_URL=
# Built-in sources (optional; each appears as a connection when set)
GITHUB_TOKEN=          # e.g. $(gh auth token) or a fine-grained PAT
STRIPE_SECRET_KEY=     # sk_test_… (test mode only)
EVENT_MCP_URL=http://localhost:7101/mcp
STRIPE_VIA_GATEWAY=    # 1 to route Stripe through agentgateway
# Sponsor integrations (optional)
SENTRY_DSN=            # Sentry project DSN: AI agent monitoring + errors
NIMBLE_API_KEY=        # Nimble API key: live web MCP (https://mcp.nimbleway.com/mcp)
SENTRY_ACCESS_TOKEN=   # Sentry user auth token for the Sentry MCP bridge (org:read, project:read, event:read, event:write)
SENTRY_ORG_SLUG=prism-2z
